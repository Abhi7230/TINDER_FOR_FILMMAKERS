    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <!-- board (outline) -->
    <path android:strokeColor="@color/tungsten" android:strokeWidth="3.08" android:fillColor="#00000000"
        android:pathData="M33.84,47.28h40.32a3.36,3.36 0 0 1 3.36,3.36v23.52a3.36,3.36 0 0 1 -3.36,3.36h-40.32a3.36,3.36 0 0 1 -3.36,-3.36v-23.52a3.36,3.36 0 0 1 3.36,-3.36z" />
