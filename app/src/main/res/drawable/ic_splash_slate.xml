<?xml version="1.0" encoding="utf-8"?>
<!-- The in-app SlateMark (ui/screens/onboarding/SlateMark.kt) as a vector, clapper open, for the system splash
     (windowSplashScreenAnimatedIcon), so the hand-off to the Compose splash shows one mark, not two. -->
