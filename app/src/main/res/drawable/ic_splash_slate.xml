        <path android:fillColor="@color/darkroom"
            android:pathData="M38.32,37.76L43.36,37.76L40,46.16L34.96,46.16Z M52.32,37.76L57.36,37.76L54,46.16L48.96,46.16Z M66.32,37.76L71.36,37.76L68,46.16L62.96,46.16Z" />
    </group>
