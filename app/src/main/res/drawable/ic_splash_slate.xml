    <path android:strokeColor="#B3FFB547" android:strokeWidth="2.46" android:strokeLineCap="butt" android:pathData="M37.2,58.48L60.72,58.48" />
    <path android:strokeColor="#B3FFB547" android:strokeWidth="2.46" android:strokeLineCap="butt" android:pathData="M37.2,67.44L51.76,67.44" />
